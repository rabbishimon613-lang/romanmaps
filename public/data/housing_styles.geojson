      "properties": {
        "id": "housing_atrium_domus",
        "typology": "atrium_domus",
        "name": "Atrium-domus houses",
        "regions": "Italy, Sicily",
        "notes": "The classic Roman house built around a columned atrium centered on an impluvium that caught rainwater from the open compluvium above. Pompeii's House of the Faun covered nearly 3,000 square meters with two atria, two peristyle gardens, and the famous Alexander Mosaic on its floor. By 117 CE this plan defined elite housing in every city of Italy and Sicily, from Rome to Syracuse.",
        "sources": [
          "https://pompeiisites.org/en/pompeii-map/analysis/roman-housing/",
          "https://en.wikipedia.org/wiki/Cavaedium",
          "https://www.unrv.com/articles/role-of-the-atrium-in-roman-houses.php"
        ]
      }
    },
