      "properties": {
        "id": "housing_roundhouse",
        "typology": "roundhouse",
        "name": "Roundhouse survivals",
        "regions": "Rural Britain, rural Gaul",
        "notes": "Round, single-room houses of timber, wattle-and-daub, or stone with conical thatched roofs, the standard Iron Age dwelling across Atlantic Europe long before Rome arrived. At Chysauster in Cornwall, Britons built stone-walled courtyard roundhouses in the early 2nd century CE and kept living in them under Roman rule. In Gaul's rural interior and Atlantic fringe, wattle-and-daub round huts still stood on ordinary farms even as elites raised new rectangular villas nearby.",
        "sources": [
          "https://en.wikipedia.org/wiki/Chysauster_Ancient_Village",
          "https://en.wikipedia.org/wiki/Roundhouse_(dwelling)",
          "https://archaeology.co.uk/articles/features/romes-homes-range.htm"
        ]
      }
