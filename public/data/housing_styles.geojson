      "properties": {
        "id": "housing_cave_dwelling",
        "typology": "cave_dwelling",
        "name": "Cave dwellings",
        "regions": "Cappadocia (central Anatolia)",
        "notes": "Cappadocians carved homes, stables, and storerooms directly into the region's soft volcanic tuff, a practice already centuries old by 117 CE. The rock holds a near-constant temperature, keeping interiors cool through Anatolian summers and warm through winters. Multi-level rock-cut complexes near Goreme and Derinkuyu began as ordinary dwellings and grain stores long before later generations turned them into refuges.",
        "sources": [
          "https://en.wikipedia.org/wiki/Rock-cut_architecture_of_Cappadocia",
          "https://cappadociacave.com/living-in-cappadocia-caves-history/"
        ]
      }
    },
