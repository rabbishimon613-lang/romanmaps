      "properties": {
        "id": "housing_egyptian_mudbrick",
        "typology": "egyptian_mudbrick",
        "name": "Egyptian mudbrick housing",
        "regions": "Fayum and rural Egypt",
        "notes": "Rural Egyptians built rectangular, flat-roofed houses of Nile mud brick packed along narrow lanes in villages up and down the river and across the Fayum depression. Karanis, a Fayum village of thousands founded under the Ptolemies, preserved mudbrick houses so completely that excavators recovered household textiles, tools, and papyri still inside them. The same building tradition, little changed by Roman rule, housed farmers from the Delta to Upper Egypt in 117 CE.",
        "sources": [
          "https://en.wikipedia.org/wiki/Karanis",
          "https://www.tandfonline.com/doi/abs/10.1080/00934690.2015.1131109",
          "https://www.academia.edu/22717679/Inside_and_Out_Romano_Egyptian_Housing_from_the_Fayyum_and_the_Dakhleh_Oasis"
        ]
      }
    }
