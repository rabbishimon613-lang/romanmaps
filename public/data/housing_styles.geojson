      "properties": {
        "id": "housing_insula",
        "typology": "insula",
        "name": "Insula apartment blocks",
        "regions": "Rome, Ostia, Puteoli",
        "notes": "Multi-story brick-and-concrete rental blocks with shops at street level and cramped apartments above, reached by narrow open stairways. Trajan capped new construction in Rome at 60 Roman feet, about 17.75 meters, after earlier building collapses and fires. Ostia's Insula of Diana still stands four stories tall, and Puteoli's volcanic concrete let builders raise equally dense blocks along that coast.",
        "sources": [
          "https://www.zmescience.com/feature-post/history-and-humanities/history/rome-invented-apartments-insulae/",
          "https://www.missedhistory.com/article/roman-insulae-ancient-apartment-buildings",
          "https://en.wikipedia.org/wiki/Insula_(building)"
        ]
      }
    },
